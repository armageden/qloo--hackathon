# TourCraft Environment Configuration
# Optional: Set your Qloo Hackathon API key. If omitted, TourCraft runs in Grounded Taste Cache mode.
QLOO_API_KEY=""

# Optional: Override Qloo API Base URL (defaults to https://hackathon.api.qloo.com)
QLOO_BASE_URL="https://hackathon.api.qloo.com"

# Optional: Set Gemini API key for live LLM Co-Pilot agentic reasoning (defaults to grounded rule engine if omitted)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Optional: Override HTTP server port (defaults to 3000)
PORT=3000
